{
  "name": "thevioletto-github-io",
  "version": "1.0.0",
  "description": "Personal Github Website",
  "type": "module",
  "scripts": {
    "sass:build": "sass --no-source-map --style=compressed --load-path=. .:.",
    "sass:watch": "sass --watch --no-source-map --load-path=. .:.",
    "lint": "stylelint \"**/*.scss\"",
    "lint:fix": "stylelint \"**/*.scss\" --fix"
  },
  "devDependencies": {
    "sass": "^1.108.2",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-scss": "^7.5.0"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^11.3.4"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy": ">=3.2.6",
      "@grpc/grpc-js": ">=1.14.7",
      "fast-xml-parser": ">=5.12.1",
      "picomatch": ">=4.0.7",
      "source-map-js": ">=1.2.4"
    }
  }
}
