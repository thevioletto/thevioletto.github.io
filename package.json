{
  "name": "thevioletto-github-io",
  "version": "1.0.0",
  "description": "Personal Github Website",
  "type": "module",
  "scripts": {
    "sass:build": "sass --no-source-map --style=compressed --load-path=. .:.",
    "sass:watch": "sass --watch --no-source-map --load-path=. .:.",
    "lint": "stylelint \"**/*.scss\"",
    "lint:fix": "stylelint \"**/*.scss\" --fix"
  },
  "devDependencies": {
    "sass": "^1.108.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.4.0"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.4"
  }
}
